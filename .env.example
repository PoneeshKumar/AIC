# Copy to .env and fill in. Never commit .env (the repo must be public at submission).

# Atlas: MUST be the cluster created through the hackathon sandbox email link.
MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR-SANDBOX-CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=coldtrace

# Voyage AI (embeddings for the failure memory). Check the Voyage docs for the current model name.
VOYAGE_API_KEY=
VOYAGE_MODEL=

# Anthropic (drafts the mapping proposal). Optional: without it the agent reuses the closest past fix.
ANTHROPIC_API_KEY=

# LangSmith tracing (optional, free credits from the event).
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false

# ElevenLabs (stretch goal only).
ELEVENLABS_API_KEY=

# Demo pacing (optional). Seconds the agent waits between steps, and budget minutes burned per real second
# while the shipment is disrupted. Set either to 0 to switch it off.
AGENT_STEP_DELAY_S=2
CLOCK_MINUTES_PER_SECOND=2

# Local ports.
SERVER_PORT=8100
CARRIER_PORT=8101
WAREHOUSE_PORT=8102
HOSPITAL_PORT=8103
